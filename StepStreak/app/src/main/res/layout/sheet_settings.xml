<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_handle" />

        <TextView
            style="@style/Text.H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Réglages ⚙️" />

        <!-- Objectif -->
        <TextView style="@style/SettingsSection" android:text="🎯  OBJECTIF QUOTIDIEN" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGoalValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:shadowColor="#80FF4FA3"
                    android:shadowRadius="18"
                    android:text="8 000"
                    android:textColor="@color/text_primary"
                    android:textSize="40sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="pas / jour"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGoalHint"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:stepSize="500"
                android:valueFrom="1000"
                android:valueTo="30000"
                app:haloColor="#33FF4FA3"
                app:labelBehavior="gone"
                app:thumbColor="@color/text_primary"
                app:tickVisible="false"
                app:trackColorActive="@color/pink"
                app:trackColorInactive="@color/slider_inactive"
                app:trackHeight="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/preset5k" style="@style/Preset" android:text="5k" />
                <TextView android:id="@+id/preset8k" style="@style/Preset" android:text="8k" />
                <TextView android:id="@+id/preset10k" style="@style/Preset" android:text="10k" />
                <TextView android:id="@+id/preset12k" style="@style/Preset" android:text="12k" />
                <TextView
                    android:id="@+id/preset15k"
                    style="@style/Preset"
                    android:layout_marginEnd="0dp"
                    android:text="15k" />
            </LinearLayout>
        </LinearLayout>

        <!-- Profil -->
        <TextView style="@style/SettingsSection" android:text="📏  PROFIL (DISTANCE &amp; CALORIES)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.H3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Taille" />

                <TextView android:id="@+id/btnHeightMinus" style="@style/Stepper" android:text="−" />

                <TextView
                    android:id="@+id/tvHeight"
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView android:id="@+id/btnHeightPlus" style="@style/Stepper" android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.H3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Poids" />

                <TextView android:id="@+id/btnWeightMinus" style="@style/Stepper" android:text="−" />

                <TextView
                    android:id="@+id/tvWeight"
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView android:id="@+id/btnWeightPlus" style="@style/Stepper" android:text="+" />
            </LinearLayout>
        </LinearLayout>

        <!-- Notifications -->
        <TextView style="@style/SettingsSection" android:text="🔔  NOTIFICATIONS &amp; SONS" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchMilestones"
                style="@style/SettingsSwitch"
                android:text="🚀  Paliers 50 % et 75 %" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchEvening"
                style="@style/SettingsSwitch"
                android:text="🔥  Alerte « série en danger » (20 h)" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchReminders"
                style="@style/SettingsSwitch"
                android:text="👟  Rappels d'inactivité" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchSounds"
                style="@style/SettingsSwitch"
                android:text="🎵  Sons dans l'app" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchHaptics"
                style="@style/SettingsSwitch"
                android:text="📳  Vibrations" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnNotifSettings"
            style="@style/Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Personnaliser les notifications" />

        <TextView style="@style/SettingsSection" android:text="⚡  FIABILITÉ" />

        <TextView
            android:id="@+id/btnBatterySheet"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Autoriser l'exécution en arrière-plan" />

        <TextView
            android:id="@+id/btnTestCelebration"
            style="@style/Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="🎉  Tester l'animation de victoire" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="StepStreak 2.0 · fait avec 🔥"
            android:textColor="@color/text_faint" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
