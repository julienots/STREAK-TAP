<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_fire"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/wFlame"
        android:layout_width="52dp"
        android:layout_height="60dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/wStreak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:shadowColor="#AAFF7A1A"
        android:shadowRadius="16"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="32sp" />

    <TextView
        android:id="@+id/wLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="jours de série"
        android:textColor="#FFD8C2"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/wGrade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_widget_chip"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:text="🥉 Bronze"
        android:textColor="#FFFFFF"
        android:textSize="10sp" />
</LinearLayout>
